# focus.yaml — Planner loop configuration
#
# This file tells the planner what to work on and how to create plans.
# Copy to focus.yaml and edit for your project.

# High-level directive for the assessment agent. Describe priorities,
# ordering, exclusions, and anything the planner should know.
description: |
  Focus on completing the orchestrator reliability improvements first,
  then address tech debt items. Skip anything related to Arena UI.

# Optional: path to an instructions file that guides plan creation.
# The plan writer agent reads this to understand conventions, constraints,
# and domain knowledge that should shape every plan it writes.
# Relative to repo root.
instructions: focus-instructions.md

# Focus areas — ordered by priority (first = highest).
areas:
  - area: orch-reliability
    priority: high
    description: |
      Fix flaky worktree cleanup and tmux session leaks in the orchestrator.
      Affected scripts: orch-engine.sh, orch-state.sh.

  - area: shell-script-tests
    priority: medium
    description: |
      Add bats tests for critical shell scripts (orch-run, orch-engine,
      orch-state). Currently untested.

# Budget — controls how many plans the loop creates per run.
budget:
  max_plans: 5
  max_consecutive_failures: 2
  cooldown_seconds: 30
