{
  "name": "canon-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canon CLI — agent-callable trading tools for Polymarket",
  "bin": {
    "canon-cli": "./canon-cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern __tests__ .",
    "test": "vitest run",
    "check": "tsc --noEmit && oxlint . && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "canon-templates": "file:../templates",
    "ethers": "5.8.0",
    "pmxtjs": "2.22.1"
  },
  "devDependencies": {
    "oxlint": "1.60.0",
    "tsx": "4.21.0",
    "typescript": "5.8.2",
    "vitest": "4.1.4"
  }
}
